// Supabase 환경 변수
// 이 파일을 복사해 Secrets.xcconfig 로 만들고 실제 값을 입력하세요.
// Secrets.xcconfig 는 .gitignore 에 포함됨 — 절대 커밋 금지
SUPABASE_ANON_KEY =

// dev 프로젝트용 Supabase 키 (threevoca-dev)
SUPABASE_DEV_ANON_KEY =

// URL의 //가 주석으로 처리되지 않도록 https:/$()/ 형식으로 입력하세요.
SUPABASE_PROD_URL =
SUPABASE_DEV_URL =

// Dev 테스트 계정 (Release에는 주입하지 않음)
DEV_ACCOUNT_EMAIL =
DEV_ACCOUNT_PASSWORD =
