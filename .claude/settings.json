{
  "permissions": {
    "deny": [
      "Read(**/Secrets.xcconfig)",
      "Read(**/.env)",
      "Read(*.env)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-sensitive-paths.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-tests-after-edit.sh",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-stop-without-tests.sh"
          }
        ]
      }
    ]
  }
}
